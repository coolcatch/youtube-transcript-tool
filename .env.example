# ─────────────────────────────────────────────────────────────
# youtube-transcript-tool — environment variables
# Copy to .env.local for local dev; set in Vercel → Project → Settings → Environment Variables.
# EVERYTHING IS OPTIONAL for the code to run. With nothing set, the app uses YouTube's own captions (free, no key).
# PRODUCTION (Vercel) currently NEEDS: TRANSCRIPT_FALLBACKS=thirdparty and TRANSCRIPT_API_KEY (Supadata),
# because YouTube blocks Vercel's servers. Set those ONLY in Vercel → Settings → Environment Variables.
# Where each one belongs: [Vercel] project env, [Local] .env.local, [CLI] exported in your shell. See README §8.
# Never commit real keys. .env / .env*.local are git-ignored.
# ─────────────────────────────────────────────────────────────

# --- Networking -------------------------------------------------
# HTTP(S) proxy for all YouTube requests. Use a residential/rotating proxy if YouTube
# blocks your server's IP (common on cloud hosts). Format: http://user:pass@host:port
YT_PROXY_URL=
# Timeout for each outgoing request, in milliseconds (default 15000).
YT_REQUEST_TIMEOUT_MS=

# --- Caching ----------------------------------------------------
# In-memory cache per server instance. TTL in seconds (default 21600 = 6h); 0 disables.
TRANSCRIPT_CACHE_TTL_SECONDS=
# Max cached transcripts per instance (default 200).
TRANSCRIPT_CACHE_MAX_ENTRIES=

# --- Fallbacks (OFF by default) ---------------------------------
# Comma-separated, tried in order after YouTube captions fail: thirdparty, whisper
# Example: TRANSCRIPT_FALLBACKS=thirdparty
TRANSCRIPT_FALLBACKS=

# [Vercel] Third-party transcript API (used when "thirdparty" is in TRANSCRIPT_FALLBACKS).
# TRANSCRIPT_API_KEY is a SECRET: set it in Vercel only (mark it Sensitive). Each new transcript = 1 credit (free plan 100/month).
# Only "supadata" is implemented (https://supadata.ai). Paid; untested without a key.
TRANSCRIPT_API_PROVIDER=supadata
TRANSCRIPT_API_KEY=
# Override the API base URL (default https://api.supadata.ai/v1).
TRANSCRIPT_API_BASE_URL=

# [CLI / self-hosted only] Whisper-compatible speech-to-text (used when "whisper" is in TRANSCRIPT_FALLBACKS).
# For videos with NO captions. Needs the yt-dlp binary → CLI / self-hosted only, not Vercel.
# Costs money per audio minute.
WHISPER_API_KEY=
# Any OpenAI-compatible /audio/transcriptions endpoint (default https://api.openai.com/v1).
WHISPER_API_BASE_URL=
# Model name (default whisper-1).
WHISPER_MODEL=
# Path to yt-dlp (default "yt-dlp" on PATH).
YTDLP_PATH=

# --- Development [Local only, never on Vercel] ---------------------
# 1 = serve fixtures/<videoId>.json instead of calling YouTube (screenshots, offline dev).
# Never set this in production.
TRANSCRIPT_FIXTURE_MODE=
